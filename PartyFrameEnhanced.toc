## Interface: 120100
## Title: Ka0s Party Frame Enhanced
## Notes: Adds party cast bars, party target frames and party pet frames to Blizzard or EllesmereUI party frames.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\PartyFrameEnhanced\media\logos\partyframeenhanced.logo.128.tga
## SavedVariables: PartyFrameEnhancedDB, PartyFrameEnhancedPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, EllesmereUI, EllesmereUIRaidFrames
## DefaultState: enabled
## Category-enUS: Group
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1698335

# Libraries (vendored in libs/ — load first)
#@no-lib-strip@
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
# The launcher's two libraries (launcher-§1). Order against LibKa0s.xml is free:
# LibKa0s-Launcher-1.0 resolves both with LibStub(..., true) at Register time, not at load.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\AceGUI-3.0-SharedMediaWidgets\widget.xml
#@end-no-lib-strip@

# Locales (first: every later file reads NS.L)
locales\enUS.lua

# Core — dependency-correct order (layout-§1). Load-bearing positions say what resolves at load;
# the rest are conventional and free to move (toc-file-§5).
# LOAD-BEARING: publishes NS.name, NS.version and NS.PREFIX, which CoreSetup and PerfSetup read.
core\Namespace.lua
# Conventional: shims are reached at call time.
core\Compat.lua
# LOAD-BEARING: Constants.FONT_MONO is resolved from the NS.MediaFont seam this file publishes,
# so it must load before core\Constants.lua.
core\MediaSetup.lua
core\Constants.lua
core\State.lua
core\Bus.lua
# Conventional: NS.Util helpers (LSM, deep copy) are reached at call time.
core\Util.lua
# Conventional: the LibKa0s-Env seam resolves nothing at load.
core\EnvSetup.lua
# LOAD-BEARING: after Namespace (NS.PREFIX), before every file that prints or captures NS.Print.
core\CoreSetup.lua
# LOAD-BEARING: publishes NS.Perf before any module takes `local Perf = NS.Perf` at file scope.
core\LifecycleSetup.lua
core\PerfSetup.lua
# LOAD-BEARING: after Constants (FONT_MONO), State (the flag) and CoreSetup (the printer),
# before anything that calls NS.Debug.
core\DebugLogSetup.lua
# Conventional: builds the launcher object, whose every seam is reached at click or Register
# time. Register itself is called from addon:OnEnable, once NS.db.global.minimap exists.
core\LauncherSetup.lua
core\Units.lua
core\Database.lua
core\PartyFrameEnhanced.lua

# Defaults (the only place a profile default is hardcoded — savedvariables-§2)
defaults\Profile.lua

# Modules (after core\PerfSetup.lua: each takes `local Perf = NS.Perf` at file scope)
# LOAD-BEARING: Providers publishes NS.Providers, which Anchor reads at call time and the features
# read through Anchor; it registers first so the lifecycle enables it first.
modules\Providers.lua
modules\Anchor.lua
# Before every feature: publishes NS.Element, which the features capture at file scope.
modules\Element.lua
modules\CastBars.lua
# Before TargetFrames and PetFrames: publishes NS.UnitButtons, which both capture at file scope.
modules\UnitButtons.lua
modules\TargetFrames.lua
modules\PetFrames.lua
# After every feature: its OnEnable reads the lock once every feature has registered with Anchor.
# The stand-in party frame preview raises when you are not in a party; publishes NS.StandIn.
modules\StandIn.lua
# LOAD-BEARING: after StandIn — Preview drives the stand-in, and reaches NS.Anchor and NS.Providers.
modules\Preview.lua

# Settings (last — depend on everything else being initialized)
# LOAD-BEARING: publishes NS.RegisterSchemaRows and the write seam, which every settings page calls
# at file load; it must stay above every settings\<page>.lua.
settings\Schema.lua
settings\Slash.lua
# LOAD-BEARING: publishes NS.Helpers, which every settings page calls at file load.
settings\OptionsSetup.lua
settings\About.lua
settings\General.lua
# LOAD-BEARING: publishes NS.ElementRows, which every feature page calls at file load.
settings\ElementRows.lua
settings\CastBars.lua
settings\TargetFrames.lua
settings\PetFrames.lua
settings\Profiles.lua
